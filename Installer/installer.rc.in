// GoaSynth installer payload + version info.
//
// Configured by CMake into build/generated/installer.rc, so the three
// RCDATA blobs are referenced by absolute path and the version strings match
// the project() version.
//
//   201  PLUGIN.RCDATA      GoaSynth.vst3 plugin binary
//   202  MODULEINFO.RCDATA  the VST3 bundle's moduleinfo.json
//   203  STANDALONE.RCDATA  the standalone GoaSynth.exe

#define IDV_PLUGIN      201
#define IDV_MODULEINFO  202
#define IDV_STANDALONE  203

IDV_PLUGIN      RCDATA "@GOA_PAYLOAD_PLUGIN@"
IDV_MODULEINFO  RCDATA "@GOA_PAYLOAD_MODULEINFO@"
IDV_STANDALONE  RCDATA "@GOA_PAYLOAD_STANDALONE@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @GOA_VERSION_CSV@,0
 PRODUCTVERSION @GOA_VERSION_CSV@,0
 FILEFLAGSMASK  0x17L
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "FreebuffAudio"
            VALUE "FileDescription",  "GoaSynth Installer"
            VALUE "FileVersion",      "@GOA_VERSION@.0"
            VALUE "ProductName",      "GoaSynth"
            VALUE "ProductVersion",   "@GOA_VERSION@.0"
            VALUE "LegalCopyright",   "AGPLv3 - source published with the plugin"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
